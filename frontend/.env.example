# Base URL of the EmailService contacts API (newsletter + unsubscribe), without /contact.
VITE_CONTACT_API_URL=https://api.inmidnightgames.com

# Base URL of the site backend's public API (dev blog), no trailing slash.
# Leave unset in a production build to ship the bundled demo posts instead.
VITE_API_URL=http://localhost:8000/api

# "true" = never call the API, render the bundled demo posts only.
VITE_USE_MOCK=false
